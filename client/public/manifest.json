{
  "manifest_version": 3,
  "name": "Tatkal Assistant",
  "version": "1.0",
  "description": "Automated form filling and captcha solving for IRCTC Tatkal bookings.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.irctc.co.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "favicon.svg",
      "48": "favicon.svg",
      "128": "favicon.svg"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.irctc.co.in/*"],
      "js": ["assets/content.js"]
    }
  ]
}
